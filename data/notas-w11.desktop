[Desktop Entry]
Type=Application
Name=Notas Autoadesivas
GenericName=Notas
Comment=Notas autoadesivas sincronizadas com o Google Keep
Exec=@BIN@/notas-w11
Icon=knotes
Categories=Utility;Qt;
Keywords=notas;keep;post-it;lembrete;sticky;
